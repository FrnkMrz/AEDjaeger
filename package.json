{
  "name": "aedjaeger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && node scripts/run-wrangler.mjs dev",
    "build": "tsc --noEmit && vite build && node scripts/check-precache.mjs",
    "worker:check": "node scripts/run-wrangler.mjs check",
    "worker:deploy": "node scripts/run-wrangler.mjs deploy",
    "test:worker-http": "node scripts/check-worker-http.mjs",
    "check:live-search": "node scripts/check-live-search.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "typescript": "^7.0.2",
    "vite": "^6.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.151.2"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "exifr": "7.1.3",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0"
  }
}
