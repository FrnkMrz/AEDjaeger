{
  "name": "aedjaeger",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && node scripts/run-wrangler.mjs dev",
    "build": "tsc --noEmit && vite build && node scripts/check-precache.mjs",
    "worker:check": "node scripts/run-wrangler.mjs check",
    "worker:deploy": "node scripts/run-wrangler.mjs deploy",
    "check:d1-migrations": "node scripts/check-d1-migrations.mjs",
    "test:worker-http": "node scripts/check-worker-http.mjs",
    "check:live-search": "node scripts/check-live-search.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.164.0"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "exifr": "7.1.3",
    "pbf": "^5.1.3",
    "pmtiles": "^4.5.0"
  }
}
