{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aedjaeger",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  // Pilot OAuth flags and endpoints are managed as dashboard vars; keep them during code deployments.
  "keep_vars": true,
  "send_metrics": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  // This binding name matches WorkerEnvironment.DB. Schema changes stay in migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aedjaeger-pilot",
      "database_id": "90ddb34e-06a9-411b-9453-e9e717cd5f79",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
