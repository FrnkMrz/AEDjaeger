{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aedjaeger",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "send_metrics": false,
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
